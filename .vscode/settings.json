{
    "rust-analyzer.checkOnSave.allTargets": false,
    "[python]": {
        "editor.defaultFormatter": "ms-python.autopep8"
    },
    "python.formatting.provider": "none",
    "C_Cpp.default.compilerPath": "/usr/bin/clang++",
    "files.associations": {
        "array": "cpp",
        "bitset": "cpp",
        "string_view": "cpp",
        "initializer_list": "cpp",
        "utility": "cpp",
        "__hash_table": "cpp",
        "__split_buffer": "cpp",
        "deque": "cpp",
        "iterator": "cpp",
        "queue": "cpp",
        "random": "cpp",
        "stack": "cpp",
        "string": "cpp",
        "unordered_map": "cpp",
        "vector": "cpp",
        "iosfwd": "cpp",
        "filesystem": "cpp",
        "stdexcept": "cpp",
        "ostream": "cpp",
        "__locale": "cpp",
        "__string": "cpp",
        "memory": "cpp",
        "optional": "cpp",
        "system_error": "cpp",
        "__threading_support": "cpp",
        "type_traits": "cpp",
        "*.tcc": "cpp",
        "__tuple": "cpp",
        "algorithm": "cpp",
        "fstream": "cpp",
        "locale": "cpp",
        "stdlib.h": "c",
        "stdio.h": "c"
    }
}